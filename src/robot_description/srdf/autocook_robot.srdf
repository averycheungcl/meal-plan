<?xml version="1.0"?>
<robot name="autocook_robot">
    
    <!-- Define the arm planning group -->
    <group name="arm">
        <chain base_link="base_link" tip_link="ee"/>
    </group>
    
    <!-- Define end effector -->
    <end_effector name="end_effector" parent_link="ee" group="arm"/>
    
    <!-- Disable collision checking between adjacent links -->
    <disable_collisions link1="base_link" link2="link1" reason="Adjacent"/>
    <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
    <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
    <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
    <disable_collisions link1="link4" link2="ee" reason="Adjacent"/>
    
    <!-- Define home position -->
    <group_state name="home" group="arm">
        <joint name="j1" value="0"/>
        <joint name="j2" value="0"/>
        <joint name="j3" value="0"/>
        <joint name="j4" value="0"/>
    </group_state>
    
    <!-- Define extended position -->
    <group_state name="extended" group="arm">
        <joint name="j1" value="0"/>
        <joint name="j2" value="1.57"/>
        <joint name="j3" value="-1.57"/>
        <joint name="j4" value="0"/>
    </group_state>
    
</robot>